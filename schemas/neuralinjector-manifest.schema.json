{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuralInjector Package Manifest",
  "description": "Manifest schema proposed for NeuralInjector Package Specification (NIP) 0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "package",
    "compatibility",
    "components",
    "integrity"
  ],
  "properties": {
    "format": {
      "const": "ailocal.neuralinjector"
    },
    "format_version": {
      "const": "0.1.0"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "kind",
        "authors",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "kind": {
          "enum": [
            "specialization",
            "optimization",
            "adapter_bundle",
            "workflow"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "uniqueItems": true
        },
        "license": {
          "type": "string",
          "maxLength": 120
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "engines"
      ],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "architecture",
              "match_policy"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "architecture": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-fA-F0-9]{64}$"
              },
              "match_policy": {
                "enum": [
                  "exact_digest",
                  "architecture_compatible"
                ]
              }
            }
          }
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "min_version": {
                "type": "string"
              },
              "required_features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugins",
        "adapters",
        "transformations",
        "hardware_profiles",
        "pipelines",
        "grammars",
        "evaluations"
      ],
      "properties": {
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "manifest",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "manifest": {
                "$ref": "#/$defs/packagePath"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "format",
              "method",
              "base_model_ref",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/packagePath"
              },
              "format": {
                "enum": [
                  "safetensors",
                  "gguf"
                ]
              },
              "method": {
                "enum": [
                  "lora",
                  "dora",
                  "ia3",
                  "other"
                ]
              },
              "base_model_ref": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "path",
              "base_model_ref",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "operation": {
                "enum": [
                  "structured_pruning",
                  "weight_delta_restore",
                  "tensor_patch",
                  "other"
                ]
              },
              "path": {
                "$ref": "#/$defs/packagePath"
              },
              "base_model_ref": {
                "type": "string"
              },
              "required_runtime_features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "hardware_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packagePath"
          },
          "uniqueItems": true
        },
        "pipelines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packagePath"
          },
          "uniqueItems": true
        },
        "grammars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packagePath"
          },
          "uniqueItems": true
        },
        "evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packagePath"
          },
          "uniqueItems": true
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version_range"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "checksums_file"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "checksums_file": {
          "$ref": "#/$defs/packagePath"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "file",
        "key_id"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "file": {
          "$ref": "#/$defs/packagePath"
        },
        "key_id": {
          "type": "string"
        }
      }
    },
    "hardware_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "recommended",
        "runtime"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/resourceRequirements"
        },
        "recommended": {
          "$ref": "#/$defs/resourceRequirements"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported_execution",
            "context_min",
            "context_recommended"
          ],
          "properties": {
            "supported_execution": {
              "type": "array",
              "items": {
                "enum": [
                  "cpu",
                  "gpu"
                ]
              },
              "minItems": 1
            },
            "context_min": {
              "type": "integer",
              "minimum": 1
            },
            "context_recommended": {
              "type": "integer",
              "minimum": 1
            },
            "required_features": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ram_mb",
        "vram_mb",
        "disk_free_mb"
      ],
      "properties": {
        "ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "vram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "disk_free_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
