{
  "format": "ailocal.neuralinjector",
  "format_version": "0.1.0",
  "package": {
    "id": "org.ailocal.programador-universal",
    "name": "Programador Universal",
    "version": "1.0.0",
    "kind": "specialization",
    "description": "Exemplo de pacote de regras de programação e português brasileiro. Não inclui pesos de modelo.",
    "authors": [
      "AILocal Universal Community"
    ],
    "license": "CC-BY-4.0"
  },
  "compatibility": {
    "models": [
      {
        "family": "qwen2.5",
        "architecture": "qwen2",
        "model_id": "qwen2.5:7b",
        "match_policy": "architecture_compatible"
      },
      {
        "family": "deepseek-r1",
        "architecture": "deepseek",
        "model_id": "deepseek-r1:7b",
        "match_policy": "architecture_compatible"
      },
      {
        "family": "flux.1",
        "architecture": "flux",
        "model_id": "flux.1",
        "match_policy": "architecture_compatible"
      }
    ],
    "engines": [
      {
        "id": "ollama",
        "required_features": [
          "chat",
          "system_message",
          "structured_json"
        ]
      },
      {
        "id": "image",
        "required_features": [
          "text_to_image",
          "artifact_output"
        ]
      }
    ],
    "platforms": [
      "linux-x86_64"
    ]
  },
  "components": {
    "plugins": [
      {
        "id": "org.ailocal.language.pt-br",
        "manifest": "plugins/pt-br/plugin.json",
        "required": true
      },
      {
        "id": "org.ailocal.programming",
        "manifest": "plugins/programming/plugin.json",
        "required": true
      }
    ],
    "adapters": [],
    "transformations": [],
    "hardware_profiles": [
      "hardware/profiles/ultra_light.json",
      "hardware/profiles/minimal.json",
      "hardware/profiles/balanced.json",
      "hardware/profiles/performance.json",
      "hardware/profiles/max_quality.json"
    ],
    "pipelines": [
      "graph/pipeline.graph.json"
    ],
    "grammars": [],
    "evaluations": [
      "evaluations/smoke.jsonl"
    ]
  },
  "dependencies": [],
  "integrity": {
    "algorithm": "sha256",
    "checksums_file": "security/checksums.sha256"
  },
  "hardware_requirements": {
    "minimum": {
      "ram_mb": 2048,
      "vram_mb": 0,
      "disk_free_mb": 256
    },
    "recommended": {
      "ram_mb": 4096,
      "vram_mb": 0,
      "disk_free_mb": 1024
    },
    "runtime": {
      "supported_execution": [
        "cpu",
        "gpu"
      ],
      "context_min": 2048,
      "context_recommended": 4096,
      "required_features": [
        "chat",
        "system_message"
      ]
    }
  }
}
