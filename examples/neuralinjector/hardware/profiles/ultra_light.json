{
  "profile_id": "ultra_light",
  "profile_version": "1.0.0",
  "description": "Contenção extrema para hosts com pouca RAM; CPU-first.",
  "requirements": {
    "min_ram_mb": 1536,
    "min_vram_mb": 0,
    "min_disk_mb": 0,
    "min_context_tokens": 512
  },
  "objectives": {
    "priority": [
      "memory",
      "reliability"
    ],
    "interactive": true
  },
  "budget": {
    "max_ram_fraction": 0.35,
    "target_context_tokens": 1024,
    "max_parallelism": 1,
    "max_cpu_threads": 2
  },
  "execution": {
    "preferred_backends": [
      "cpu"
    ],
    "allow_cpu_fallback": true,
    "require_gpu": false
  },
  "degradation": {
    "disable_optional_components": true,
    "reduce_context": true,
    "reduce_parallelism": true,
    "allow_artifact_fallback": true
  },
  "benchmark": {
    "default": "none",
    "allowed": [
      "none",
      "quick"
    ]
  },
  "quantization_policy": {
    "preferred": [
      "Q4_0",
      "Q3_K_M",
      "Q2_K",
      "Q4_K_M"
    ],
    "low_memory_preferred": [
      "Q3_K_M",
      "Q2_K",
      "Q4_0"
    ],
    "low_memory_threshold_mb": 4096,
    "allow_lower_precision_fallback": true
  }
}
